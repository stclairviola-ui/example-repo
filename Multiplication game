import random

def play_game():
    correct = 0
    incorrect = 0
    
    print("========================================")
    print("      MULTIPLICATION CHALLENGE         ")
    print("========================================")
    
    while True:
        num1 = random.randint(2, 12)
        num2 = random.randint(2, 12)
        answer = num1 * num2
        
        # Big Letters and Calculation
        print(f"\n\n    {num1}  X  {num2}  =  ?")
        
        user_input = input("\nSubmit your answer (or type 'exit' to quit): ")
        
        if user_input.lower() == 'exit':
            break
            
        try:
            if int(user_input) == answer:
                correct += 1
                # Red for Right
                print("\033[1;31m" + "    CORRECT! (RED)" + "\033[0m")
            else:
                incorrect += 1
                # Blue for Wrong
                print("\033[1;34m" + f"    WRONG! (BLUE) The answer was {answer}" + "\033[0m")
        except ValueError:
            print("Please enter a valid number.")

        # Scoreboard
        print("\n----------------------------------------")
        print(f" SCORE: {correct} Right | {incorrect} Wrong")
        print("----------------------------------------")

# To run this, you would call play_game()